      "on_disk": "manim/B32.mp4",
      "method": "manim",
      "who": "pipeline",
      "scene_hint": "animated_graphics",
      "prompt": null,
      "slot": "manim/B32.mp4",
      "label": "Scratch is huge. Ten terabytes, and up to fifteen million files. But nothing in scratch can be recov"
