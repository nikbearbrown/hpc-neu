      "method": "manim",
      "who": "pipeline",
      "scene_hint": "animated_graphics",
      "prompt": null,
      "slot": "manim/B31.mp4",
      "label": "Home holds a hundred gigabytes. Delete a file there by accident, and you have seven days to recover "
    },
